#!/usr/bin/env node
'use strict';
const fs = require('node:fs');
const path = require('node:path');
const cp = require('node:child_process');

const root = path.resolve(process.argv[2] || '.');
let names;
try {
  names = fs.readFileSync(path.join(root, 'rays.txt'), 'utf8')
    .split(/\r?\n/).map(x => x.trim()).filter(x => x && !x.startsWith('#'));
} catch (err) {
  console.error(`FAIL rays: cannot read rays.txt: ${err.message}`);
  process.exit(1);
}
if (!names.length || new Set(names).size !== names.length) {
  console.error('FAIL rays: list is empty or repeats a ray name');
  process.exit(1);
}
let failures = 0;
for (const name of names) {
  if (!/^[a-z][a-z0-9-]*$/.test(name)) { console.error(`FAIL rays: invalid name ${name}`); failures++; continue; }
  const goal = path.join(root, name, 'GOALS.md');
  const result = cp.spawnSync(process.execPath, [path.join(__dirname, 'check-goals'), goal], { encoding: 'utf8' });
  if (result.status !== 0) {
    console.error(`FAIL rays: ${name}\n${result.stderr || result.stdout || result.error}`);
    failures++;
  } else console.log(`PASS ray: ${name}`);
}
if (failures) {
  console.error(`FAIL rays: ${failures} invalid ray(s)`);
  process.exit(1);
}
console.log(`PASS rays: ${names.length} active ray(s) have valid GOALS.md`);
